# Copy this file to .env and set each value to a secret file path before running
# Docker Compose. Store strong, distinct secret values in those untracked files;
# .env contains paths only, never the secret values themselves.
MSSQL_SA_PASSWORD_FILE=
MSSQL_MIGRATION_PASSWORD_FILE=
MSSQL_APP_PASSWORD_FILE=
JWT_SIGNING_KEY_FILE=

