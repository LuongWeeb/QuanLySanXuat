# Copy this file to .env and set strong, distinct values before running Docker Compose.
# Never commit the populated .env file.
MSSQL_SA_PASSWORD=
MSSQL_MIGRATION_PASSWORD=
MSSQL_APP_PASSWORD=
JWT_SECRET_KEY=

