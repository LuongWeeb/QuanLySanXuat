@model IEnumerable<WmsMes.Web.Domain.Entities.ProductionPlan>
@using WmsMes.Web.Domain.Enums
@{
    ViewData["Title"] = "Kế hoạch sản xuất";
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">MES · MRP tổng hợp</p>
        <h2>Quản lý Kế hoạch sản xuất</h2>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tạo kế hoạch</a>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info mt-3" role="status">@statusMessage</div>
}

<section class="data-panel mt-3" aria-labelledby="production-plan-list-heading">
    <div class="p-3">
        <h3 class="h5 mb-0" id="production-plan-list-heading">Danh sách kế hoạch</h3>
    </div>
    <div class="table-responsive">
        <table class="table data-table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Số kế hoạch</th>
                    <th scope="col">Ngày kế hoạch</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var plan in Model)
            {
                <tr>
                    <td><code>@plan.PlanNo</code></td>
                    <td>@plan.PlanDate.ToVietnameseDate()</td>
                    <td><span class="status-pill">@plan.Status.ToVietnameseString()</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Details"
                           asp-route-id="@plan.Id">Chi tiết</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        Chưa có kế hoạch sản xuất.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
