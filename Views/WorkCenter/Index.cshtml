@using WmsMes.Web.Domain.Entities
@model IEnumerable<WorkCenter>
@{
    ViewData["Title"] = "Trạm sản xuất & chi phí";
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">Cấu hình sản xuất</p>
        <h2>Trạm sản xuất & chi phí giờ</h2>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm trạm</a>
</section>

<section class="data-panel">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr>
                    <th>Mã trạm</th>
                    <th>Tên trạm</th>
                    <th class="text-end">Nhân công / giờ</th>
                    <th class="text-end">Máy móc / giờ</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.Code</code></td>
                    <td>@item.Name</td>
                    <td class="text-end">@item.HourlyLaborRate.ToVietnameseNumber() VNĐ</td>
                    <td class="text-end">@item.HourlyMachineRate.ToVietnameseNumber() VNĐ</td>
                    <td><span class="status-pill @(item.IsActive ? "is-active" : "is-muted")">@(item.IsActive ? "Hoạt động" : "Ngừng")</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa chi phí</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state compact">
            <h3>Chưa có trạm sản xuất</h3>
            <p>Thêm trạm để cấu hình chi phí nhân công và máy móc theo giờ.</p>
        </div>
    }
</section>
