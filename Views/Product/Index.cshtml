@using WmsMes.Web.Domain.Entities
@using WmsMes.Web.Domain.Enums
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
    var uoms = ViewBag.UnitOfMeasures as IEnumerable<UnitOfMeasure> ?? Enumerable.Empty<UnitOfMeasure>();
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Planner");
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">Master data</p>
        <h2>SKU & đơn vị tính</h2>
    </div>
    @if (canEdit)
    {
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addProductModal">
            Thêm sản phẩm
        </button>
    }
</section>

<section class="data-panel">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr>
                    <th>Mã SKU</th>
                    <th>Tên sản phẩm</th>
                    <th>Loại</th>
                    <th>UOM</th>
                    <th class="text-end">Min</th>
                    <th class="text-end">Max</th>
                    <th>Lot</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.Code</code></td>
                    <td>@item.Name</td>
                    <td>@item.Type</td>
                    <td>@(item.BaseUom?.Code ?? "-")</td>
                    <td class="text-end">@item.MinStock.ToString("N2")</td>
                    <td class="text-end">@item.MaxStock.ToString("N2")</td>
                    <td>@(item.IsLotTracked ? "Có" : "Không")</td>
                    <td>
                        <span class="status-pill @(item.IsActive ? "is-active" : "is-muted")">
                            @(item.IsActive ? "Hoạt động" : "Ngừng")
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state compact">
            <h3>Chưa có sản phẩm</h3>
            <p>Tạo UOM trong cơ sở dữ liệu, sau đó thêm SKU để bắt đầu danh mục sản phẩm.</p>
        </div>
    }
</section>

@if (canEdit)
{
    <div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Create" method="post">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="addProductModalLabel">Thêm sản phẩm</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" for="Code">Mã SKU</label>
                                <input class="form-control" id="Code" name="Code" required maxlength="100" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label" for="Name">Tên sản phẩm</label>
                                <input class="form-control" id="Name" name="Name" required maxlength="250" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="Type">Loại</label>
                                <select class="form-select" id="Type" name="Type">
                                    <option value="@ProductType.RawMaterial">Raw material</option>
                                    <option value="@ProductType.WIP">WIP</option>
                                    <option value="@ProductType.FinishedGood">Finished good</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="BaseUomId">UOM</label>
                                <select class="form-select" id="BaseUomId" name="BaseUomId" required>
                                    @foreach (var uom in uoms)
                                    {
                                        <option value="@uom.Id">@uom.Code - @uom.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="MinStock">Min</label>
                                <input class="form-control" id="MinStock" name="MinStock" type="number" min="0" step="0.01" value="0" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="MaxStock">Max</label>
                                <input class="form-control" id="MaxStock" name="MaxStock" type="number" min="0" step="0.01" value="0" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" id="IsManufactured" name="IsManufactured" type="checkbox" value="true" />
                                    <label class="form-check-label" for="IsManufactured">Tự sản xuất</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" id="IsLotTracked" name="IsLotTracked" type="checkbox" value="true" />
                                    <label class="form-check-label" for="IsLotTracked">Quản lý lot</label>
                                </div>
                            </div>
                            <input type="hidden" name="IsActive" value="true" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary" @(uoms.Any() ? null : "disabled")>Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
