@using WmsMes.Web.Domain.Entities
@using WmsMes.Web.Domain.Enums
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
    var uoms = ViewBag.UnitOfMeasures as IEnumerable<UnitOfMeasure> ?? Enumerable.Empty<UnitOfMeasure>();
    var stockBalances = ViewData["StockBalances"] as IEnumerable<StockBalance> ?? Enumerable.Empty<StockBalance>();
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Planner");
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">Dữ liệu danh mục</p>
        <h2>SKU & đơn vị tính</h2>
    </div>
    @if (canEdit)
    {
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addProductModal">
            Thêm sản phẩm
        </button>
    }
</section>

<section class="data-panel">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr>
                    <th>Mã SKU</th>
                    <th>Tên sản phẩm</th>
                    <th>Loại</th>
                    <th>UOM</th>
                    <th class="text-end">Tồn tối thiểu</th>
                    <th class="text-end">Tồn tối đa</th>
                    <th>Lô</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tồn kho</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.Code</code></td>
                    <td>@item.Name</td>
                    <td>@item.Type.ToVietnameseString()</td>
                    <td>@(item.BaseUom?.Code ?? "-")</td>
                    <td class="text-end">@item.MinStock.ToVietnameseNumber()</td>
                    <td class="text-end">@item.MaxStock.ToVietnameseNumber()</td>
                    <td>@(item.IsLotTracked ? "Có" : "Không")</td>
                    <td>
                        <span class="status-pill @(item.IsActive ? "is-active" : "is-muted")">
                            @(item.IsActive ? "Hoạt động" : "Ngừng")
                        </span>
                    </td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#productStockModal-@item.Id" aria-label="Xem vị trí tồn kho của @item.Code">
                            Vị trí tồn
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state compact">
            <h3>Chưa có sản phẩm</h3>
            <p>Tạo UOM trong cơ sở dữ liệu, sau đó thêm SKU để bắt đầu danh mục sản phẩm.</p>
        </div>
    }
</section>

@foreach (var item in Model)
{
    var productBalances = stockBalances.Where(balance => balance.ProductId == item.Id).ToList();
    <div class="modal fade" id="productStockModal-@item.Id" tabindex="-1" aria-labelledby="productStockModalLabel-@item.Id" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="productStockModalLabel-@item.Id">Vị trí tồn kho: @item.Code</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    @if (productBalances.Any())
                    {
                        <div class="table-responsive">
                            <table class="table data-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Vị trí kho</th>
                                        <th>Số lô</th>
                                        <th class="text-end">Khả dụng</th>
                                        <th class="text-end">Giữ chỗ</th>
                                        <th class="text-end">Tạm giữ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var balance in productBalances)
                                {
                                    <tr>
                                        <td><code>@balance.Location?.Code</code></td>
                                        <td><code>@balance.Lot?.LotNo</code></td>
                                        <td class="text-end">@balance.QtyAvailable.ToVietnameseNumber()</td>
                                        <td class="text-end">@balance.QtyReserved.ToVietnameseNumber()</td>
                                        <td class="text-end">@balance.QtyOnHold.ToVietnameseNumber()</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state compact">
                            <p class="mb-0">Không có tồn kho tại vị trí nào cho sản phẩm này.</p>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@if (canEdit)
{
    <div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Create" method="post">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="addProductModalLabel">Thêm sản phẩm</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" for="Code">Mã SKU</label>
                                <input class="form-control" id="Code" name="Code" required maxlength="100" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label" for="Name">Tên sản phẩm</label>
                                <input class="form-control" id="Name" name="Name" required maxlength="250" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="Type">Loại</label>
                                <select class="form-select" id="Type" name="Type">
                                    <option value="@ProductType.RawMaterial">@ProductType.RawMaterial.ToVietnameseString()</option>
                                    <option value="@ProductType.WIP">@ProductType.WIP.ToVietnameseString()</option>
                                    <option value="@ProductType.FinishedGood">@ProductType.FinishedGood.ToVietnameseString()</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="BaseUomId">UOM</label>
                                <select class="form-select" id="BaseUomId" name="BaseUomId" required>
                                    @foreach (var uom in uoms)
                                    {
                                        <option value="@uom.Id">@uom.Code - @uom.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="MinStock">Tồn tối thiểu</label>
                                <input class="form-control" id="MinStock" name="MinStock" type="number" min="0" step="0.01" value="0" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="MaxStock">Tồn tối đa</label>
                                <input class="form-control" id="MaxStock" name="MaxStock" type="number" min="0" step="0.01" value="0" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" id="IsManufactured" name="IsManufactured" type="checkbox" value="true" />
                                    <label class="form-check-label" for="IsManufactured">Tự sản xuất</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" id="IsLotTracked" name="IsLotTracked" type="checkbox" value="true" />
                                    <label class="form-check-label" for="IsLotTracked">Quản lý lô</label>
                                </div>
                            </div>
                            <input type="hidden" name="IsActive" value="true" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary" @(uoms.Any() ? null : "disabled")>Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
