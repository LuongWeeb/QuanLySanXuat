@model IEnumerable<WmsMes.Web.Domain.Entities.QCChecklist>
@{
    ViewData["Title"] = "Mẫu tiêu chuẩn QC";
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">Kiểm soát chất lượng</p>
        <h2>Mẫu tiêu chuẩn kiểm định</h2>
        <p class="text-muted mb-0">Quản lý dải tiêu chuẩn theo từng sản phẩm.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tạo mẫu QC</a>
</section>

<section class="data-panel mt-3">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Tên mẫu</th>
                    <th class="text-center">Tiêu chí</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var checklist in Model)
            {
                <tr>
                    <td><code>@checklist.Product?.Code</code> — @checklist.Product?.Name</td>
                    <td>@checklist.Name</td>
                    <td class="text-center">@checklist.Items.Count</td>
                    <td>
                        <span class="status-pill @(checklist.IsActive ? "is-active" : "is-muted")">
                            @(checklist.IsActive ? "Đang áp dụng" : "Ngừng áp dụng")
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Edit"
                           asp-route-id="@checklist.Id">Chỉnh sửa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state compact">
            <h3>Chưa có mẫu tiêu chuẩn</h3>
            <p>Tạo mẫu đầu tiên để tự động đánh giá kết quả kiểm định.</p>
        </div>
    }
</section>
