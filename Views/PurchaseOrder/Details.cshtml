@model WmsMes.Web.Domain.Entities.PurchaseOrder
@using WmsMes.Web.Domain.Enums
@{ ViewData["Title"] = $"Đơn mua hàng {Model.OrderNo}"; }
<section class="toolbar-row"><div><p class="eyebrow">Mua hàng · PO</p><h2>@Model.OrderNo</h2></div><a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></section>
<section class="ops-panel mt-3"><dl class="row mb-0"><dt class="col-sm-3">Nhà cung cấp</dt><dd class="col-sm-9">@Model.Supplier?.Code - @Model.Supplier?.Name</dd><dt class="col-sm-3">Yêu cầu nguồn</dt><dd class="col-sm-9">@Model.PurchaseRequest?.RequestNo</dd><dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9"><span class="status-pill">@Model.Status.ToVietnameseString()</span></dd></dl></section>
<section class="data-panel mt-3"><div class="table-responsive"><table class="table data-table align-middle mb-0"><thead><tr><th>Sản phẩm</th><th class="text-end">Đặt</th><th class="text-end">Đã nhận</th><th class="text-end">Đơn giá</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Product?.Code - @item.Product?.Name</td><td class="text-end">@item.Qty.ToVietnameseNumber()</td><td class="text-end">@item.ReceivedQty.ToVietnameseNumber()</td><td class="text-end">@item.UnitPrice.ToVietnameseNumber()</td></tr>}</tbody></table></div></section>
