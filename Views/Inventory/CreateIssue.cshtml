@using WmsMes.Web.Domain.Entities
@{
    ViewData["Title"] = "Tạo phiếu xuất kho";
    var balances = (IEnumerable<StockBalance>)ViewBag.AvailableBalances;
}

<section class="toolbar-row"><div><p class="eyebrow">Goods Issue</p><h2>Tạo Phiếu Xuất kho mới</h2></div></section>

<div class="ops-panel mt-3 col-md-8">
    <form asp-action="CreateIssue" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label for="stockSelection" class="form-label">Sản phẩm / Lô / Vị trí khả dụng (FEFO/FIFO)</label>
            <select id="stockSelection" class="form-select" required>
                <option value="">-- Chọn tồn kho khả dụng --</option>
                @foreach (var balance in balances)
                {
                    <option value="@balance.ProductId|@balance.LotId|@balance.LocationId"
                            data-product-id="@balance.ProductId" data-lot-id="@balance.LotId" data-location-id="@balance.LocationId">
                        @balance.Product?.Code - @balance.Product?.Name | @balance.Lot?.LotNo | HSD: @(balance.Lot?.ExpiryDate?.ToString("yyyy-MM-dd") ?? "FIFO") | @balance.Location?.Code | Có thể xuất: @balance.QtyAvailable.ToString("N2")
                    </option>
                }
            </select>
            <input id="productId" name="productId" type="hidden" />
            <input id="lotId" name="lotId" type="hidden" />
            <input id="locationId" name="locationId" type="hidden" />
        </div>
        <div class="mb-3">
            <label for="qty" class="form-label">Số lượng xuất</label>
            <input id="qty" name="qty" type="number" class="form-control" min="0.01" step="0.01" required />
        </div>
        <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Xác nhận xuất kho</button><a class="btn btn-outline-secondary" asp-action="Issues">Hủy</a></div>
    </form>
</div>

<script>
    document.getElementById('stockSelection').addEventListener('change', function () {
        const option = this.options[this.selectedIndex];
        document.getElementById('productId').value = option.dataset.productId || '';
        document.getElementById('lotId').value = option.dataset.lotId || '';
        document.getElementById('locationId').value = option.dataset.locationId || '';
    });
</script>
