@using WmsMes.Web.Domain.Entities
@using WmsMes.Web.ViewModels
@model CreateIssueViewModel
@{
    ViewData["Title"] = "Tạo phiếu xuất kho";
    var balances = (IEnumerable<StockBalance>)ViewBag.AvailableBalances;
    var customers = (IEnumerable<Customer>)ViewBag.Customers;
}

<section class="toolbar-row"><div><p class="eyebrow">Phiếu xuất kho</p><h2>Tạo Phiếu Xuất kho mới</h2></div></section>

<div class="ops-panel mt-3">
    <div class="card mb-3 border-primary">
        <div class="card-body py-2">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-qr-code-scan" aria-hidden="true"></i></span>
                <input type="text" id="barcode-scanner-input" class="form-control" placeholder="Quét mã SKU, Số lô hoặc Vị trí..." aria-label="Mã SKU, số lô hoặc vị trí" autocomplete="off" autofocus />
                <button type="button" class="btn btn-outline-primary" id="btn-camera-scan" data-bs-toggle="modal" data-bs-target="#cameraScanModal">
                    <i class="bi bi-camera" aria-hidden="true"></i> Quét bằng Camera
                </button>
            </div>
            <div id="scan-status" class="small text-muted mt-2" role="status" aria-live="polite">Sẵn sàng quét mã.</div>
        </div>
    </div>
    <form asp-action="CreateIssue" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3 col-md-6">
            <label asp-for="CustomerId" class="form-label">Khách hàng</label>
            <select asp-for="CustomerId" class="form-select" required>
                <option value="">-- Chọn khách hàng --</option>
                @foreach (var customer in customers)
                {
                    <option value="@customer.Id">@customer.Code - @customer.Name</option>
                }
            </select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Sản phẩm / Lô / Vị trí khả dụng (FEFO/FIFO)</th><th>Số lượng xuất</th><th><span class="visually-hidden">Thao tác</span></th></tr></thead>
                <tbody id="issue-lines">
                    @for (var index = 0; index < Model.Lines.Count; index++)
                    {
                        var line = Model.Lines[index];
                        var qtyKey = $"Lines[{index}].Qty";
                        var qtyValue = ViewData.ModelState.TryGetValue(qtyKey, out var qtyEntry)
                            ? qtyEntry.AttemptedValue
                            : line.Qty.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        <tr data-line-row>
                            <td>
                                <label class="visually-hidden" data-stock-label>Tồn kho khả dụng</label>
                                <select class="form-select" data-stock-selection required>
                                    <option value="">-- Chọn tồn kho khả dụng --</option>
                                    @foreach (var balance in balances)
                                    {
                                        var selected = balance.ProductId == line.ProductId && balance.LotId == line.LotId && balance.LocationId == line.LocationId;
                                        <option value="@balance.ProductId|@balance.LotId|@balance.LocationId"
                                                data-product-id="@balance.ProductId" data-lot-id="@balance.LotId" data-location-id="@balance.LocationId"
                                                data-product-code="@balance.Product?.Code" data-lot-no="@balance.Lot?.LotNo" data-location-code="@balance.Location?.Code"
                                                selected="@(selected ? "selected" : null)">
                                            @balance.Product?.Code - @balance.Product?.Name | @balance.Lot?.LotNo | HSD: @(balance.Lot?.ExpiryDate?.ToVietnameseDate() ?? "FIFO") | @balance.Location?.Code | Có thể xuất: @balance.QtyAvailable.ToVietnameseNumber()
                                        </option>
                                    }
                                </select>
                                <input name="Lines[@index].ProductId" value="@line.ProductId" data-field="ProductId" type="hidden" />
                                <input name="Lines[@index].LotId" value="@line.LotId" data-field="LotId" type="hidden" />
                                <input name="Lines[@index].LocationId" value="@line.LocationId" data-field="LocationId" type="hidden" />
                                @Html.ValidationMessage($"Lines[{index}].ProductId", null, new { @class = "text-danger d-block", data_validation_for = "ProductId" })
                                @Html.ValidationMessage($"Lines[{index}].LotId", null, new { @class = "text-danger d-block", data_validation_for = "LotId" })
                                @Html.ValidationMessage($"Lines[{index}].LocationId", null, new { @class = "text-danger d-block", data_validation_for = "LocationId" })
                            </td>
                            <td>
                                <label class="visually-hidden" data-label-for="Qty">Số lượng xuất</label>
                                <input name="Lines[@index].Qty" value="@qtyValue" data-field="Qty" type="number" class="form-control" min="0.01" step="0.01" required />
                                @Html.ValidationMessage($"Lines[{index}].Qty", null, new { @class = "text-danger", data_validation_for = "Qty" })
                            </td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-line>Xóa dòng</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.ValidationMessage("Lines", null, new { @class = "text-danger d-block mb-2" })
        <button type="button" id="add-issue-line" class="btn btn-outline-primary mb-3">Thêm dòng</button>
        <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Xác nhận xuất kho</button><a class="btn btn-outline-secondary" asp-action="Issues">Hủy</a></div>
    </form>
</div>

<div class="modal fade" id="cameraScanModal" tabindex="-1" aria-labelledby="cameraScanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="cameraScanModalLabel">Quét QR bằng Camera</h2>
                <button type="button" class="btn-close" id="btn-close-camera" data-bs-dismiss="modal" aria-label="Đóng camera"></button>
            </div>
            <div class="modal-body">
                <div id="reader" class="w-100"></div>
            </div>
        </div>
    </div>
</div>

<template id="issue-line-template">
    <tr data-line-row>
        <td>
            <label class="visually-hidden" data-stock-label>Tồn kho khả dụng</label>
            <select class="form-select" data-stock-selection required>
                <option value="">-- Chọn tồn kho khả dụng --</option>
                @foreach (var balance in balances)
                {
                    <option value="@balance.ProductId|@balance.LotId|@balance.LocationId"
                            data-product-id="@balance.ProductId" data-lot-id="@balance.LotId" data-location-id="@balance.LocationId"
                            data-product-code="@balance.Product?.Code" data-lot-no="@balance.Lot?.LotNo" data-location-code="@balance.Location?.Code">
                        @balance.Product?.Code - @balance.Product?.Name | @balance.Lot?.LotNo | HSD: @(balance.Lot?.ExpiryDate?.ToVietnameseDate() ?? "FIFO") | @balance.Location?.Code | Có thể xuất: @balance.QtyAvailable.ToVietnameseNumber()
                    </option>
                }
            </select>
            <input name="Lines[__index__].ProductId" data-field="ProductId" type="hidden" />
            <input name="Lines[__index__].LotId" data-field="LotId" type="hidden" />
            <input name="Lines[__index__].LocationId" data-field="LocationId" type="hidden" />
        </td>
        <td><label class="visually-hidden" data-label-for="Qty">Số lượng xuất</label><input name="Lines[__index__].Qty" data-field="Qty" type="number" class="form-control" min="0.01" step="0.01" required /></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-line>Xóa dòng</button></td>
    </tr>
</template>

<script>
    (() => {
        const lines = document.getElementById('issue-lines');
        const template = document.getElementById('issue-line-template');

        function copyStockSelection(row) {
            const selection = row.querySelector('[data-stock-selection]');
            const option = selection.options[selection.selectedIndex];
            row.querySelector('[data-field="ProductId"]').value = option?.dataset.productId || '';
            row.querySelector('[data-field="LotId"]').value = option?.dataset.lotId || '';
            row.querySelector('[data-field="LocationId"]').value = option?.dataset.locationId || '';
        }

        function reindexLines() {
            const rows = lines.querySelectorAll('[data-line-row]');
            rows.forEach((row, index) => {
                const stockSelection = row.querySelector('[data-stock-selection]');
                stockSelection.id = `issue-line-${index}-stock`;
                row.querySelector('[data-stock-label]').htmlFor = stockSelection.id;
                row.querySelectorAll('[data-field]').forEach(field => {
                    const fieldName = field.dataset.field;
                    field.name = `Lines[${index}].${fieldName}`;
                    field.id = `issue-line-${index}-${fieldName}`;
                });
                row.querySelectorAll('[data-label-for]').forEach(label => {
                    label.htmlFor = `issue-line-${index}-${label.dataset.labelFor}`;
                });
                row.querySelectorAll('[data-validation-for]').forEach(message => {
                    message.dataset.valmsgFor = `Lines[${index}].${message.dataset.validationFor}`;
                });
            });
        }

        function resetRow(row) {
            const selection = row.querySelector('[data-stock-selection]');
            selection.selectedIndex = 0;
            Array.from(selection.options).forEach(option => option.hidden = false);
            row.querySelectorAll('input').forEach(input => input.value = '');
            delete row.dataset.scanProductCode;
            delete row.dataset.scanLotNo;
            delete row.dataset.scanLocationCode;
        }

        document.getElementById('add-issue-line').addEventListener('click', () => {
            const index = lines.querySelectorAll('[data-line-row]').length;
            lines.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__index__', index));
            reindexLines();
        });

        lines.addEventListener('change', event => {
            if (event.target.matches('[data-stock-selection]')) copyStockSelection(event.target.closest('[data-line-row]'));
        });

        lines.addEventListener('click', event => {
            const button = event.target.closest('[data-remove-line]');
            if (!button) return;
            const rows = lines.querySelectorAll('[data-line-row]');
            const row = button.closest('[data-line-row]');
            if (rows.length === 1) {
                resetRow(row);
                return;
            }
            row.remove();
            reindexLines();
        });

        reindexLines();
    })();
</script>

<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
    (() => {
        const scannerInput = document.getElementById('barcode-scanner-input');
        const scanStatus = document.getElementById('scan-status');
        const cameraModal = document.getElementById('cameraScanModal');
        let camera = null;
        let cameraSession = 0;
        let scanHandled = false;

        function currentRow() {
            return document.querySelector('#issue-lines [data-line-row]:last-child');
        }

        function rowForSku() {
            let row = currentRow();
            if (!row || row.querySelector('[data-stock-selection]')?.value) {
                document.getElementById('add-issue-line').click();
                row = currentRow();
            }
            return row;
        }

        function showScanNotification(message, type = 'muted') {
            scanStatus.textContent = message;
            scanStatus.className = `small mt-2 text-${type}`;
        }

        function playBeep() {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const context = new AudioContext();
            const oscillator = context.createOscillator();
            const gain = context.createGain();
            oscillator.connect(gain);
            gain.connect(context.destination);
            gain.gain.value = 0.08;
            oscillator.frequency.value = 880;
            oscillator.start();
            oscillator.stop(context.currentTime + 0.08);
            oscillator.addEventListener('ended', () => context.close());
        }

        function optionMatchesCriteria(option, row) {
            return Boolean(option.value) &&
                (!row.dataset.scanProductCode ||
                    option.dataset.productCode?.toUpperCase() === row.dataset.scanProductCode) &&
                (!row.dataset.scanLotNo ||
                    option.dataset.lotNo?.toUpperCase() === row.dataset.scanLotNo) &&
                (!row.dataset.scanLocationCode ||
                    option.dataset.locationCode?.toUpperCase() === row.dataset.scanLocationCode);
        }

        function resolveStockSelection(row, scannedLabel) {
            const selection = row.querySelector('[data-stock-selection]');
            const stockOptions = Array.from(selection.options).filter(option => option.value);
            const candidates = stockOptions.filter(option => optionMatchesCriteria(option, row));
            stockOptions.forEach(option => option.hidden = !candidates.includes(option));
            selection.value = '';
            selection.dispatchEvent(new Event('change', { bubbles: true }));

            if (candidates.length === 1) {
                selection.value = candidates[0].value;
                selection.dispatchEvent(new Event('change', { bubbles: true }));
                showScanNotification(`Đã chọn duy nhất dòng tồn khớp: ${scannedLabel}`, 'success');
                playBeep();
                return;
            }

            if (candidates.length > 1) {
                showScanNotification(
                    `Có ${candidates.length} dòng tồn phù hợp. Hãy quét thêm Lot hoặc Vị trí.`,
                    'warning');
                playBeep();
                return;
            }

            showScanNotification(`Không có dòng tồn khớp đồng thời các mã đã quét: ${scannedLabel}`, 'warning');
        }

        function processScan(rawCode) {
            const code = rawCode.trim().toUpperCase();
            if (!code) return;

            const allOptions = Array.from(document.querySelectorAll('#issue-lines [data-stock-selection] option[value]'));
            const isSku = allOptions.some(option => option.dataset.productCode?.toUpperCase() === code);
            let row = isSku ? rowForSku() : currentRow();
            const selection = row?.querySelector('[data-stock-selection]');
            if (!selection) {
                showScanNotification('Hãy thêm một dòng trước khi quét.', 'warning');
                return;
            }

            if (isSku) {
                row.dataset.scanProductCode = code;
                delete row.dataset.scanLotNo;
                delete row.dataset.scanLocationCode;
                resolveStockSelection(row, rawCode.trim());
                scannerInput.focus();
                return;
            }

            const stockOptions = Array.from(selection.options).filter(option => option.value);
            const matchesLot = stockOptions.some(option => option.dataset.lotNo?.toUpperCase() === code);
            const matchesLocation = stockOptions.some(option => option.dataset.locationCode?.toUpperCase() === code);
            if (!matchesLot && !matchesLocation) {
                showScanNotification(`Không tìm thấy lô hàng hoặc vị trí phù hợp: ${rawCode.trim()}`, 'warning');
                scannerInput.focus();
                return;
            }
            if (matchesLot && matchesLocation) {
                showScanNotification(`Mã ${rawCode.trim()} trùng cả Lot và Vị trí; vui lòng quét mã phân biệt.`, 'warning');
                scannerInput.focus();
                return;
            }

            const criterionKey = matchesLot ? 'scanLotNo' : 'scanLocationCode';
            const previousValue = row.dataset[criterionKey];
            row.dataset[criterionKey] = code;
            const hasCandidate = stockOptions.some(option => optionMatchesCriteria(option, row));
            if (!hasCandidate) {
                if (previousValue) row.dataset[criterionKey] = previousValue;
                else delete row.dataset[criterionKey];
            }
            resolveStockSelection(row, rawCode.trim());
            scannerInput.focus();
        }

        scannerInput.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
                event.preventDefault();
                processScan(scannerInput.value);
                scannerInput.value = '';
            }
        });

        cameraModal.addEventListener('shown.bs.modal', async () => {
            if (typeof Html5Qrcode === 'undefined') {
                showScanNotification('Không thể tải thư viện quét camera.', 'danger');
                return;
            }

            const session = ++cameraSession;
            scanHandled = false;
            const scanner = new Html5Qrcode("reader");
            camera = scanner;
            try {
                await scanner.start(
                    { facingMode: 'environment' },
                    { fps: 10, qrbox: { width: 250, height: 250 } },
                    decodedText => {
                        if (session !== cameraSession || scanHandled) return;
                        scanHandled = true;
                        processScan(decodedText);
                        bootstrap.Modal.getOrCreateInstance(cameraModal).hide();
                    },
                    () => {});
                if (session !== cameraSession) {
                    if (scanner.isScanning) await scanner.stop().catch(() => {});
                    scanner.clear();
                    if (camera === scanner) camera = null;
                }
            } catch {
                if (session !== cameraSession) return;
                showScanNotification('Không thể truy cập camera. Vui lòng kiểm tra quyền trình duyệt.', 'danger');
                bootstrap.Modal.getOrCreateInstance(cameraModal).hide();
            }
        });

        cameraModal.addEventListener('hidden.bs.modal', async () => {
            ++cameraSession;
            const scanner = camera;
            if (scanner?.isScanning) {
                await scanner.stop().catch(() => {});
            }
            scanner?.clear();
            if (camera === scanner) camera = null;
            scannerInput.focus();
        });
    })();
</script>
