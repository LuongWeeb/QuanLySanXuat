@model WmsMes.Web.ViewModels.InventoryIndexViewModel
@{
    ViewData["Title"] = "Tồn kho thực tế";
    var balances = Model.Balances.ToList();
    var totalAvailable = balances.Sum(item => item.QtyAvailable);
    var totalReserved = balances.Sum(item => item.QtyReserved);
    var totalOnHold = balances.Sum(item => item.QtyOnHold);
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">Tồn kho thực tế</p>
        <h2>Tồn kho theo lô và vị trí</h2>
    </div>
    <div class="connection-pill" id="inventoryConnectionState" aria-live="polite">
        <span class="connection-dot"></span>
        Đang kết nối
    </div>
</section>

<partial name="_LowStockAlert" model="Model.LowStockItems" />

<section class="metric-grid" aria-label="Tóm tắt tồn kho">
    <article class="metric-card">
        <span>Khả dụng</span>
        <strong>@totalAvailable.ToVietnameseNumber()</strong>
    </article>
    <article class="metric-card">
        <span>Giữ chỗ</span>
        <strong>@totalReserved.ToVietnameseNumber()</strong>
    </article>
    <article class="metric-card">
        <span>Tạm giữ</span>
        <strong>@totalOnHold.ToVietnameseNumber()</strong>
    </article>
    <article class="metric-card">
        <span>Dòng tồn</span>
        <strong>@balances.Count.ToVietnameseNumber()</strong>
    </article>
</section>

<section class="data-panel">
    <div class="table-responsive">
        <table class="table data-table align-middle" id="stockTable">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Lô</th>
                    <th>Hạn dùng</th>
                    <th>Vị trí</th>
                    <th class="text-end">Khả dụng</th>
                    <th class="text-end">Giữ chỗ</th>
                    <th class="text-end">Tạm giữ</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in balances)
            {
                <tr>
                    <td>
                        <code>@item.Product?.Code</code>
                        <span class="table-subtext">@item.Product?.Name</span>
                    </td>
                    <td><code>@item.Lot?.LotNo</code></td>
                    <td>@(item.Lot?.ExpiryDate?.ToVietnameseDate() ?? "-")</td>
                    <td>
                        <code>@item.Location?.Code</code>
                        <span class="table-subtext">@item.Location?.Zone?.Code</span>
                    </td>
                    <td class="text-end fw-semibold">@item.QtyAvailable.ToVietnameseNumber()</td>
                    <td class="text-end">@item.QtyReserved.ToVietnameseNumber()</td>
                    <td class="text-end">
                        <span class="hold-value @(item.QtyOnHold > 0 ? "has-hold" : "")">@item.QtyOnHold.ToVietnameseNumber()</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!balances.Any())
    {
        <div class="empty-state compact">
            <h3>Chưa có tồn kho</h3>
            <p>Hoàn thành phiếu nhập kho để tạo số dư theo lô và vị trí.</p>
        </div>
    }
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const state = document.getElementById("inventoryConnectionState");
        const setConnectionState = (label, modifier) => {
            state.className = `connection-pill ${modifier}`;
            state.lastChild.textContent = ` ${label}`;
        };

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/inventoryHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveStockUpdate", () => {
            setConnectionState("Có cập nhật mới", "is-live");
            window.setTimeout(() => window.location.reload(), 450);
        });

        connection.onreconnecting(() => setConnectionState("Đang nối lại", "is-waiting"));
        connection.onreconnected(() => setConnectionState("Thời gian thực", "is-live"));
        connection.onclose(() => setConnectionState("Mất kết nối", "is-offline"));

        connection.start()
            .then(() => setConnectionState("Thời gian thực", "is-live"))
            .catch(() => setConnectionState("Không kết nối", "is-offline"));
    </script>
}
