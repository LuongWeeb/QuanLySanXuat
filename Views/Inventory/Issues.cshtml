@model IEnumerable<WmsMes.Web.Domain.Entities.GoodsIssue>
@using WmsMes.Web.Domain.Enums
@inject TimeZoneInfo BusinessTimeZone
@{
    ViewData["Title"] = "Xuất kho";
}

<section class="toolbar-row">
    <div><p class="eyebrow">WMS</p><h2>Lịch sử Xuất kho</h2></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Transactions">Sổ cái kho</a>
        <a class="btn btn-primary" asp-action="CreateIssue">Tạo phiếu xuất</a>
    </div>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info mt-3" role="status">@statusMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
}

<section class="data-panel mt-3">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead><tr><th>Mã Phiếu</th><th>Khách hàng</th><th>Sản phẩm</th><th>Lô xuất</th><th>Vị trí</th><th class="text-end">Số lượng</th><th>Ngày xuất</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var issue in Model)
            {
                var lines = issue.Lines.ToList();
                foreach (var indexedLine in lines.Select((line, index) => new { Line = line, Index = index }))
                {
                    var line = indexedLine.Line;
                    <tr class="@(issue.Status == DocumentStatus.Cancelled ? "text-muted" : "")">
                        <td><code>@issue.IssueNo</code></td><td>@issue.Customer?.Code - @issue.Customer?.Name</td><td>@line.Product?.Name</td><td><code>@line.Lot?.LotNo</code></td>
                        <td><code>@line.Location?.Code</code></td><td class="text-end fw-semibold text-danger">-@line.Qty.ToVietnameseNumber()</td>
                        <td>@issue.IssueDate.ToVietnameseBusinessDateTime(BusinessTimeZone)</td>
                        @if (indexedLine.Index == 0)
                        {
                            <td rowspan="@lines.Count">
                                @if (issue.Status == DocumentStatus.Cancelled)
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                }
                                else if (issue.Status == DocumentStatus.Completed)
                                {
                                    <span class="badge bg-success">@issue.Status.ToVietnameseString()</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@issue.Status.ToVietnameseString()</span>
                                }
                            </td>
                            <td rowspan="@lines.Count">
                                @if (issue.Status == DocumentStatus.Completed)
                                {
                                    <form asp-action="CancelIssue"
                                          asp-route-id="@issue.Id"
                                          method="post"
                                          asp-antiforgery="true"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn hủy phiếu xuất kho này? Số lượng tồn kho sẽ được trả lại.');"
                                          class="d-inline">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                aria-label="Hủy phiếu xuất kho @issue.IssueNo">Hủy phiếu</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted" aria-label="Không có thao tác">—</span>
                                }
                            </td>
                        }
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
