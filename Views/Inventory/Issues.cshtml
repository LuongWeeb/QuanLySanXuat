@model IEnumerable<WmsMes.Web.Domain.Entities.GoodsIssue>
@{
    ViewData["Title"] = "Xuất kho";
}

<section class="toolbar-row">
    <div><p class="eyebrow">WMS</p><h2>Lịch sử Xuất kho</h2></div>
    <a class="btn btn-primary" asp-action="CreateIssue">Tạo phiếu xuất</a>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info mt-3">@statusMessage</div>
}

<section class="data-panel mt-3">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead><tr><th>Mã Phiếu</th><th>Sản phẩm</th><th>Lô xuất</th><th>Vị trí</th><th class="text-end">Số lượng</th><th>Ngày xuất</th></tr></thead>
            <tbody>
            @foreach (var issue in Model)
            {
                foreach (var line in issue.Lines)
                {
                    <tr>
                        <td><code>@issue.IssueNo</code></td><td>@line.Product?.Name</td><td><code>@line.Lot?.LotNo</code></td>
                        <td><code>@line.Location?.Code</code></td><td class="text-end fw-semibold text-danger">-@line.Qty.ToString("N2")</td>
                        <td>@issue.IssueDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
