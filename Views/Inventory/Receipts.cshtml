@model IEnumerable<WmsMes.Web.Domain.Entities.GoodsReceipt>
@inject TimeZoneInfo BusinessTimeZone
@{
    ViewData["Title"] = "Nhập kho mua hàng";
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">WMS</p>
        <h2>Lịch sử Nhập kho</h2>
    </div>
    <a class="btn btn-primary" asp-action="CreateReceipt">Nhập lô mới</a>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info mt-3">@statusMessage</div>
}

<section class="data-panel mt-3">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr>
                    <th>Mã Phiếu</th>
                    <th>Sản phẩm</th>
                    <th>Nhà cung cấp</th>
                    <th>Mã Lô</th>
                    <th>Vị trí</th>
                    <th class="text-end">Số lượng</th>
                    <th>Ngày nhập</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var receipt in Model)
            {
                foreach (var line in receipt.Lines)
                {
                    <tr>
                        <td><code>@receipt.ReceiptNo</code></td>
                        <td>@line.Product?.Name</td>
                        <td>@receipt.Supplier?.Name</td>
                        <td><code>@line.LotNo</code></td>
                        <td><code>@line.Location?.Code</code></td>
                        <td class="text-end fw-semibold text-success">+@line.Qty.ToVietnameseNumber()</td>
                        <td>@receipt.ReceiptDate.ToVietnameseBusinessDateTime(BusinessTimeZone)</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
