@using WmsMes.Web.Domain.Entities
@using WmsMes.Web.ViewModels
@model CreateReceiptViewModel
@{
    ViewData["Title"] = "Tạo phiếu nhập kho";
    var products = (IEnumerable<Product>)ViewBag.Products;
    var locations = (IEnumerable<Location>)ViewBag.Locations;
    var purchaseOrders = (IEnumerable<PurchaseOrder>)ViewBag.PurchaseOrders;
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">Phiếu nhập kho</p>
        <h2>Tạo Phiếu Nhập kho mới</h2>
    </div>
</section>

<div class="ops-panel mt-3">
    <div class="card mb-3 border-primary">
        <div class="card-body py-2">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-qr-code-scan" aria-hidden="true"></i></span>
                <input type="text" id="barcode-scanner-input" class="form-control" placeholder="Quét mã SKU sản phẩm, Số lô hoặc Vị trí..." aria-label="Mã SKU, số lô hoặc vị trí" autocomplete="off" autofocus />
                <button type="button" class="btn btn-outline-primary" id="btn-camera-scan" data-bs-toggle="modal" data-bs-target="#cameraScanModal">
                    <i class="bi bi-camera" aria-hidden="true"></i> Quét bằng Camera
                </button>
            </div>
            <div id="scan-status" class="small text-muted mt-2" role="status" aria-live="polite">Sẵn sàng quét mã.</div>
        </div>
    </div>
    <form asp-action="CreateReceipt" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3 col-md-6">
            <label asp-for="PurchaseOrderId" class="form-label">Đơn mua hàng (PO)</label>
            <select asp-for="PurchaseOrderId" id="purchase-order-select" class="form-select">
                <option value="">-- Nhập kho không theo PO --</option>
                @foreach (var order in purchaseOrders)
                {
                    <option value="@order.Id">@order.OrderNo · @order.Supplier?.Name</option>
                }
            </select>
            <div class="form-text">Chọn PO để nạp nhà cung cấp và số lượng còn phải nhận.</div>
            <span asp-validation-for="PurchaseOrderId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-6">
            <label asp-for="SupplierId" class="form-label">Nhà cung cấp</label>
            <select asp-for="SupplierId" class="form-select" required>
                <option value="">-- Chọn nhà cung cấp --</option>
                @foreach (var supplier in ViewBag.Suppliers)
                {
                    <option value="@supplier.Id">@supplier.Name</option>
                }
            </select>
            <span asp-validation-for="SupplierId" class="text-danger"></span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lô</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Vị trí</th>
                        <th>Lý do chênh lệch</th>
                        <th><span class="visually-hidden">Thao tác</span></th>
                    </tr>
                </thead>
                <tbody id="receipt-lines">
                    @for (var index = 0; index < Model.Lines.Count; index++)
                    {
                        var line = Model.Lines[index];
                        var qtyKey = $"Lines[{index}].Qty";
                        var qtyValue = ViewData.ModelState.TryGetValue(qtyKey, out var qtyEntry)
                            ? qtyEntry.AttemptedValue
                            : line.Qty.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var unitPriceKey = $"Lines[{index}].UnitPrice";
                        var unitPriceValue = ViewData.ModelState.TryGetValue(unitPriceKey, out var unitPriceEntry)
                            ? unitPriceEntry.AttemptedValue
                            : line.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var reasonKey = $"Lines[{index}].VarianceReason";
                        var reasonValue = ViewData.ModelState.TryGetValue(reasonKey, out var reasonEntry)
                            ? reasonEntry.AttemptedValue
                            : line.VarianceReason;
                        <tr data-line-row>
                            <td>
                                <label class="visually-hidden" data-label-for="ProductId">Sản phẩm</label>
                                <select name="Lines[@index].ProductId" data-field="ProductId" class="form-select" required>
                                    <option value="">-- Chọn sản phẩm --</option>
                                    @foreach (var product in ViewBag.Products)
                                    {
                                        <option value="@product.Id" selected="@(product.Id == line.ProductId ? "selected" : null)">@product.Code - @product.Name</option>
                                    }
                                </select>
                                @Html.ValidationMessage($"Lines[{index}].ProductId", null, new { @class = "text-danger", data_validation_for = "ProductId" })
                            </td>
                            <td>
                                <label class="visually-hidden" data-label-for="LotNo">Số lô</label>
                                <input name="Lines[@index].LotNo" value="@line.LotNo" data-field="LotNo" class="form-control" required />
                                @Html.ValidationMessage($"Lines[{index}].LotNo", null, new { @class = "text-danger", data_validation_for = "LotNo" })
                            </td>
                            <td>
                                <label class="visually-hidden" data-label-for="Qty">Số lượng</label>
                                <input name="Lines[@index].Qty" value="@qtyValue" data-field="Qty" type="number" class="form-control" min="0.01" step="0.01" required />
                                @Html.ValidationMessage($"Lines[{index}].Qty", null, new { @class = "text-danger", data_validation_for = "Qty" })
                            </td>
                            <td>
                                <label class="visually-hidden" data-label-for="UnitPrice">Đơn giá</label>
                                <input name="Lines[@index].UnitPrice" value="@unitPriceValue" data-field="UnitPrice" type="number" class="form-control" min="0" step="0.01" required />
                                @Html.ValidationMessage($"Lines[{index}].UnitPrice", null, new { @class = "text-danger", data_validation_for = "UnitPrice" })
                            </td>
                            <td>
                                <label class="visually-hidden" data-label-for="LocationId">Vị trí</label>
                                <select name="Lines[@index].LocationId" data-field="LocationId" class="form-select" required>
                                    <option value="">-- Chọn vị trí --</option>
                                    @foreach (var location in ViewBag.Locations)
                                    {
                                        <option value="@location.Id" selected="@(location.Id == line.LocationId ? "selected" : null)">@location.Code</option>
                                    }
                                </select>
                                @Html.ValidationMessage($"Lines[{index}].LocationId", null, new { @class = "text-danger", data_validation_for = "LocationId" })
                            </td>
                            <td style="min-width: 220px">
                                <label class="visually-hidden" data-label-for="VarianceReason">Lý do chênh lệch</label>
                                <textarea name="Lines[@index].VarianceReason"
                                          data-field="VarianceReason"
                                          class="form-control"
                                          maxlength="250"
                                          rows="2">@reasonValue</textarea>
                                @Html.ValidationMessage($"Lines[{index}].VarianceReason", null, new { @class = "text-danger", data_validation_for = "VarianceReason" })
                            </td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-line>Xóa dòng</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.ValidationMessage("Lines", null, new { @class = "text-danger d-block mb-2" })
        <button type="button" id="add-receipt-line" class="btn btn-outline-primary mb-3">Thêm dòng</button>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Xác nhận nhập kho</button>
            <a class="btn btn-outline-secondary" asp-action="Receipts">Hủy</a>
        </div>
    </form>
</div>

<div class="modal fade" id="cameraScanModal" tabindex="-1" aria-labelledby="cameraScanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="cameraScanModalLabel">Quét QR bằng Camera</h2>
                <button type="button" class="btn-close" id="btn-close-camera" data-bs-dismiss="modal" aria-label="Đóng camera"></button>
            </div>
            <div class="modal-body">
                <div id="reader" class="w-100"></div>
            </div>
        </div>
    </div>
</div>

<template id="receipt-line-template">
    <tr data-line-row>
        <td>
            <label class="visually-hidden" data-label-for="ProductId">Sản phẩm</label>
            <select name="Lines[__index__].ProductId" data-field="ProductId" class="form-select" required>
                <option value="">-- Chọn sản phẩm --</option>
                @foreach (var product in ViewBag.Products)
                {
                    <option value="@product.Id">@product.Code - @product.Name</option>
                }
            </select>
        </td>
        <td><label class="visually-hidden" data-label-for="LotNo">Số lô</label><input name="Lines[__index__].LotNo" data-field="LotNo" class="form-control" required /></td>
        <td><label class="visually-hidden" data-label-for="Qty">Số lượng</label><input name="Lines[__index__].Qty" data-field="Qty" type="number" class="form-control" min="0.01" step="0.01" required /></td>
        <td><label class="visually-hidden" data-label-for="UnitPrice">Đơn giá</label><input name="Lines[__index__].UnitPrice" data-field="UnitPrice" type="number" class="form-control" min="0" step="0.01" required /></td>
        <td>
            <label class="visually-hidden" data-label-for="LocationId">Vị trí</label>
            <select name="Lines[__index__].LocationId" data-field="LocationId" class="form-select" required>
                <option value="">-- Chọn vị trí --</option>
                @foreach (var location in ViewBag.Locations)
                {
                    <option value="@location.Id">@location.Code</option>
                }
            </select>
        </td>
        <td>
            <label class="visually-hidden" data-label-for="VarianceReason">Lý do chênh lệch</label>
            <textarea name="Lines[__index__].VarianceReason" data-field="VarianceReason" class="form-control" maxlength="250" rows="2"></textarea>
        </td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-line>Xóa dòng</button></td>
    </tr>
</template>

<script>
    (() => {
        const lines = document.getElementById('receipt-lines');
        const template = document.getElementById('receipt-line-template');
        const purchaseOrders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            purchaseOrders.Select(order => new {
                id = order.Id,
                supplierId = order.SupplierId,
                orderNo = order.OrderNo,
                items = order.Items.Select(item => new {
                    productId = item.ProductId,
                    qty = Math.Max(0m, item.Qty - item.ReceivedQty),
                    unitPrice = item.UnitPrice
                })
            })));

        function reindexLines() {
            const rows = lines.querySelectorAll('[data-line-row]');
            rows.forEach((row, index) => {
                row.querySelectorAll('[data-field]').forEach(field => {
                    const fieldName = field.dataset.field;
                    field.name = `Lines[${index}].${fieldName}`;
                    field.id = `receipt-line-${index}-${fieldName}`;
                });
                row.querySelectorAll('[data-label-for]').forEach(label => {
                    label.htmlFor = `receipt-line-${index}-${label.dataset.labelFor}`;
                });
                row.querySelectorAll('[data-validation-for]').forEach(message => {
                    message.dataset.valmsgFor = `Lines[${index}].${message.dataset.validationFor}`;
                });
            });
        }

        function resetRow(row) {
            row.querySelectorAll('input').forEach(input => input.value = '');
            row.querySelectorAll('textarea').forEach(textarea => textarea.value = '');
            row.querySelectorAll('select').forEach(select => select.selectedIndex = 0);
        }

        document.getElementById('add-receipt-line').addEventListener('click', () => {
            const index = lines.querySelectorAll('[data-line-row]').length;
            lines.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__index__', index));
            reindexLines();
        });

        lines.addEventListener('click', event => {
            const button = event.target.closest('[data-remove-line]');
            if (!button) return;
            const rows = lines.querySelectorAll('[data-line-row]');
            const row = button.closest('[data-line-row]');
            if (rows.length === 1) {
                resetRow(row);
                return;
            }
            row.remove();
            reindexLines();
        });

        document.getElementById('purchase-order-select').addEventListener('change', event => {
            const order = purchaseOrders.find(candidate => String(candidate.id) === event.target.value);
            if (!order) return;
            document.getElementById('SupplierId').value = String(order.supplierId);
            lines.innerHTML = '';
            order.items.filter(item => item.qty > 0).forEach(item => {
                document.getElementById('add-receipt-line').click();
                const row = lines.lastElementChild;
                row.querySelector('[data-field="ProductId"]').value = String(item.productId);
                row.querySelector('[data-field="Qty"]').value = item.qty;
                row.querySelector('[data-field="UnitPrice"]').value = item.unitPrice;
                row.querySelector('[data-field="LotNo"]').value = `${order.orderNo}-${item.productId}`;
            });
            if (!lines.children.length) document.getElementById('add-receipt-line').click();
            reindexLines();
        });

        reindexLines();
    })();
</script>

<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
    (() => {
        const productsMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            products.Select(product => new { id = product.Id, code = product.Code })));
        const locationsMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            locations.Select(location => new { id = location.Id, code = location.Code })));
        const scannerInput = document.getElementById('barcode-scanner-input');
        const scanStatus = document.getElementById('scan-status');
        const cameraModal = document.getElementById('cameraScanModal');
        let camera = null;
        let cameraSession = 0;
        let scanHandled = false;
        let cameraOperation = Promise.resolve();

        function currentRow() {
            return document.querySelector('#receipt-lines [data-line-row]:last-child');
        }

        function rowForProduct() {
            let row = currentRow();
            const product = row?.querySelector('[data-field="ProductId"]');
            const lot = row?.querySelector('[data-field="LotNo"]');
            if (!row || product?.value || lot?.value) {
                document.getElementById('add-receipt-line').click();
                row = currentRow();
            }
            return row;
        }

        function showScanNotification(message, type = 'muted') {
            scanStatus.textContent = message;
            scanStatus.className = `small mt-2 text-${type}`;
        }

        function playBeep() {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const context = new AudioContext();
            const oscillator = context.createOscillator();
            const gain = context.createGain();
            oscillator.connect(gain);
            gain.connect(context.destination);
            gain.gain.value = 0.08;
            oscillator.frequency.value = 880;
            oscillator.start();
            oscillator.stop(context.currentTime + 0.08);
            oscillator.addEventListener('ended', () => context.close());
        }

        function processScan(rawCode) {
            const code = rawCode.trim();
            if (!code) return;

            const location = locationsMap.find(item => item.code.toUpperCase() === code.toUpperCase());
            if (location) {
                const select = currentRow()?.querySelector('[data-field="LocationId"]');
                if (select) {
                    select.value = String(location.id);
                    showScanNotification(`Đã chọn vị trí: ${location.code}`, 'success');
                    playBeep();
                }
                scannerInput.focus();
                return;
            }

            const product = productsMap.find(item => item.code.toUpperCase() === code.toUpperCase());
            if (product) {
                const select = rowForProduct()?.querySelector('[data-field="ProductId"]');
                if (select) {
                    select.value = String(product.id);
                    showScanNotification(`Đã thêm sản phẩm: ${product.code}`, 'success');
                    playBeep();
                }
                scannerInput.focus();
                return;
            }

            const lotInput = currentRow()?.querySelector('[data-field="LotNo"]');
            if (lotInput) {
                lotInput.value = code;
                showScanNotification(`Đã điền số lô: ${code}`, 'info');
                playBeep();
            } else {
                showScanNotification('Hãy thêm một dòng trước khi quét số lô.', 'warning');
            }
            scannerInput.focus();
        }

        scannerInput.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
                event.preventDefault();
                processScan(scannerInput.value);
                scannerInput.value = '';
            }
        });

        async function cleanupScanner(scanner) {
            if (!scanner) return;
            if (scanner.isScanning) {
                await scanner.stop().catch(() => {});
            }
            try {
                scanner.clear();
            } catch {
                // Scanner may never have completed startup.
            }
            if (camera === scanner) camera = null;
        }

        cameraModal.addEventListener('shown.bs.modal', () => {
            if (typeof Html5Qrcode === 'undefined') {
                showScanNotification('Không thể tải thư viện quét camera.', 'danger');
                return;
            }

            const session = ++cameraSession;
            scanHandled = false;
            cameraOperation = cameraOperation.catch(() => {}).then(async () => {
                if (session !== cameraSession) return;
                const scanner = new Html5Qrcode("reader");
                camera = scanner;
                try {
                    await scanner.start(
                        { facingMode: 'environment' },
                        { fps: 10, qrbox: { width: 250, height: 250 } },
                        decodedText => {
                            if (session !== cameraSession || scanHandled) return;
                            scanHandled = true;
                            processScan(decodedText);
                            bootstrap.Modal.getOrCreateInstance(cameraModal).hide();
                        },
                        () => {});
                } catch {
                    if (session === cameraSession) {
                        showScanNotification('Không thể truy cập camera. Vui lòng kiểm tra quyền trình duyệt.', 'danger');
                        bootstrap.Modal.getOrCreateInstance(cameraModal).hide();
                    }
                }
            });
        });

        cameraModal.addEventListener('hidden.bs.modal', () => {
            ++cameraSession;
            cameraOperation = cameraOperation.catch(() => {}).then(async () => {
                const scanner = camera;
                await cleanupScanner(scanner);
                scannerInput.focus();
            });
        });
    })();
</script>
