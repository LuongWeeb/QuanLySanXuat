@model IReadOnlyList<WmsMes.Web.Domain.Entities.SalesOrder>
@using WmsMes.Web.Domain.Enums
@{
    ViewData["Title"] = "Đơn bán hàng";
}
<section class="toolbar-row">
    <div><p class="eyebrow">Bán hàng · SO</p><h2>Đơn bán hàng</h2></div>
    <a class="btn btn-primary" asp-action="Create">Tạo đơn bán hàng</a>
</section>
@if (TempData["StatusMessage"] is string message) { <div class="alert alert-info mt-3" role="status">@message</div> }
<section class="data-panel mt-3">
    <div class="table-responsive">
        <table class="table data-table align-middle mb-0">
            <thead><tr><th>Mã SO</th><th>Khách hàng</th><th>Ngày đặt</th><th>Ngày giao</th><th class="text-end">Giá trị</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><code>@order.OrderNo</code></td><td>@order.Customer?.Code - @order.Customer?.Name</td>
                    <td>@order.OrderDate.ToVietnameseDate()</td><td>@order.DeliveryDate.ToVietnameseDate()</td>
                    <td class="text-end">@order.Items.Sum(item => item.Qty * item.UnitPrice).ToVietnameseNumber()</td>
                    <td><span class="status-pill">@order.Status.ToVietnameseString()</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.Id">Chi tiết</a></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có đơn bán hàng.</td></tr> }
            </tbody>
        </table>
    </div>
</section>
