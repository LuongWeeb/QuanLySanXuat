@using WmsMes.Web.Domain.Entities
@using WmsMes.Web.Services
@inject INotificationService NotificationService
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var unreadNotificationCount = 0;
    var recentNotifications = Array.Empty<AppNotification>();
    if (isAuthenticated)
    {
        unreadNotificationCount = await NotificationService.GetUnreadCountAsync();
        recentNotifications = (await NotificationService.GetRecentNotificationsAsync()).ToArray();
    }

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS MES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@500;600&family=Fira+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WmsMes.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <aside class="app-sidebar" aria-label="Điều hướng chính">
        <a class="brand-lockup" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">WM</span>
            <span>
                <strong>WMS MES</strong>
                <small>Vận hành</small>
            </span>
        </a>
        <nav class="side-nav">
            <div class="nav-section-title">Tổng quan</div>
            <a asp-controller="Home" asp-action="Index">Bảng điều khiển</a>
            <a asp-controller="Dashboard" asp-action="Index">Dashboard Nhà máy & OEE</a>

            <div class="nav-section-title">Quản lý Kho (WMS)</div>
            <a asp-controller="Inventory" asp-action="Index">Số dư tồn kho</a>
            <a asp-controller="Inventory" asp-action="Receipts">Nhập kho</a>
            <a asp-controller="Inventory" asp-action="Issues">Xuất kho</a>
            <a asp-controller="Warehouse" asp-action="Index">Kho & Vị trí</a>
            <a asp-controller="CycleCount" asp-action="Index">Kiểm kê kho (Stocktake)</a>
            @if (User.IsInRole("Admin") || User.IsInRole("Warehouse") || User.IsInRole("Manager"))
            {
                <a class="@(currentController == "PickList" ? "active" : null)" asp-controller="PickList" asp-action="Index">Danh sách lấy hàng</a>
            }

            <div class="nav-section-title">Báo cáo &amp; Phân tích</div>
            <a class="@(currentController == "Report" ? "active" : null)" asp-controller="Report" asp-action="StockValuation">Báo cáo Tài chính Kho</a>

            <div class="nav-section-title">Quản lý Sản xuất (MES)</div>
            @if (User.IsInRole("Admin") || User.IsInRole("Planner") || User.IsInRole("Manager"))
            {
                <a asp-controller="WorkOrder" asp-action="Index">Lệnh sản xuất</a>
                <a asp-controller="ProductionPlan" asp-action="Index">Kế hoạch sản xuất (MRP)</a>
                <a asp-controller="Mrp" asp-action="Index">Lập kế hoạch MRP</a>
                <a asp-controller="Bom" asp-action="Index">Định mức vật tư (BOM)</a>
                <a asp-controller="WorkCenter" asp-action="Index">Trạm sản xuất & chi phí</a>
                <div class="nav-section-title">Mua hàng & Bán hàng</div>
                <a asp-controller="SalesOrder" asp-action="Index">Đơn bán hàng (SO)</a>
                <a asp-controller="PurchaseOrder" asp-action="Index">Đơn mua hàng (PO)</a>
                <a asp-controller="PurchaseOrder" asp-action="Requests">Yêu cầu mua hàng (PR)</a>
            }
            <a asp-controller="Worker" asp-action="Index">Trạm vận hành</a>
            <a asp-controller="Product" asp-action="Index">Sản phẩm (SKU)</a>

            <div class="nav-section-title">Kiểm soát Chất lượng & Truy vết</div>
            <a asp-controller="QcChecklist" asp-action="Index">Mẫu tiêu chuẩn QC</a>
            <a asp-controller="Qc" asp-action="Pending">Đợt kiểm định QC</a>
            <a asp-controller="Traceability" asp-action="Index">Truy vết lô hàng</a>
        </nav>
    </aside>
    <div class="app-main">
        <header class="app-topbar">
            <div>
                <p class="eyebrow">Nền tảng vận hành</p>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="topbar-actions">
                <form class="d-flex gap-2" asp-controller="Home" asp-action="Search" method="get">
                    <label class="visually-hidden" for="global-search">Tìm kiếm toàn hệ thống</label>
                    <input class="form-control form-control-sm" id="global-search" type="search" name="q" required
                           style="max-width: 250px" placeholder="Tìm SKU, lệnh SX, số lô..." />
                    <button class="btn btn-outline-primary btn-sm" type="submit">Tìm</button>
                </form>
                @if (isAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-link position-relative p-1 text-decoration-none" type="button"
                                id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                                aria-label="Thông báo hệ thống">
                            <span aria-hidden="true" class="fs-5">&#128276;</span>
                            <span id="unread-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(unreadNotificationCount == 0 ? "d-none" : null)"
                                  aria-label="@unreadNotificationCount thông báo chưa đọc">@unreadNotificationCount</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-0 notification-menu" aria-labelledby="notificationDropdown">
                            <div class="d-flex align-items-center justify-content-between px-3 py-2">
                                <strong>Thông báo hệ thống</strong>
                                <span class="small text-muted">Mới nhất</span>
                            </div>
                            <div class="dropdown-divider my-0"></div>
                            <div id="notification-list" aria-label="Danh sách thông báo gần đây">
                                @foreach (var notification in recentNotifications)
                                {
                                    var isSafeReferenceUrl = !string.IsNullOrWhiteSpace(notification.ReferenceUrl)
                                        && notification.ReferenceUrl.StartsWith('/')
                                        && !notification.ReferenceUrl.StartsWith("//", StringComparison.Ordinal)
                                        && !notification.ReferenceUrl.Contains('\\');
                                    <div class="notification-item px-3 py-2">
                                        <div class="d-flex justify-content-between gap-2"><strong class="small">@notification.Title</strong><time class="small text-muted text-nowrap" datetime="@notification.CreatedAt.ToUniversalTime().ToString("O")">@notification.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</time></div>
                                        <div class="small text-muted">@notification.Message</div>
                                        @if (isSafeReferenceUrl)
                                        {
                                            <a class="small stretched-link" href="@notification.ReferenceUrl">Xem chi tiết</a>
                                        }
                                    </div>
                                }
                                @if (recentNotifications.Length == 0)
                                {
                                    <p class="text-muted small text-center mb-0 px-3 py-3" id="notification-empty">Chưa có thông báo mới.</p>
                                }
                            </div>
                        </div>
                    </div>
                    <span class="user-chip">@User.Identity?.Name</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button class="btn btn-outline-secondary btn-sm" type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                }
            </div>
        </header>
        <main role="main" class="content-frame">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (isAuthenticated)
    {
        <script src="~/lib/microsoft-signalr/8.0.0/signalr.min.js"></script>
        <script>
            (() => {
                const badge = document.getElementById("unread-count");
                const list = document.getElementById("notification-list");
                const liveRegion = document.getElementById("notification-live-region");
                if (!badge || !list || !window.signalR) return;

                const isSafeReferenceUrl = value => typeof value === "string"
                    && value.startsWith("/") && !value.startsWith("//") && !value.includes("\\");
                const updateBadge = change => {
                    const count = Math.max(0, Number.parseInt(badge.textContent, 10) || 0) + change;
                    badge.textContent = String(count);
                    badge.classList.toggle("d-none", count === 0);
                    badge.setAttribute("aria-label", `${count} thông báo chưa đọc`);
                };
                const renderNotification = notification => {
                    const empty = document.getElementById("notification-empty");
                    empty?.remove();
                    const item = document.createElement("div");
                    item.className = "notification-item px-3 py-2";
                    const heading = document.createElement("strong");
                    heading.className = "small";
                    heading.textContent = notification.title || "Thông báo hệ thống";
                    const time = document.createElement("time");
                    time.className = "small text-muted text-nowrap";
                    const createdAt = notification.createdAt ? new Date(notification.createdAt) : new Date();
                    time.dateTime = createdAt.toISOString();
                    time.textContent = createdAt.toLocaleString("vi-VN", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" });
                    const header = document.createElement("div");
                    header.className = "d-flex justify-content-between gap-2";
                    header.append(heading, time);
                    const message = document.createElement("div");
                    message.className = "small text-muted";
                    message.textContent = notification.message || "";
                    item.append(header, message);
                    if (isSafeReferenceUrl(notification.referenceUrl)) {
                        const link = document.createElement("a");
                        link.className = "small stretched-link";
                        link.href = notification.referenceUrl;
                        link.textContent = "Xem chi tiết";
                        item.append(link);
                    }
                    list.prepend(item);
                    while (list.querySelectorAll(".notification-item").length > 5) list.lastElementChild?.remove();
                };

                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect()
                    .build();
                connection.on("ReceiveNotification", notification => {
                    renderNotification(notification || {});
                    if (!notification?.isRead) updateBadge(1);
                    if (liveRegion) liveRegion.textContent = `${notification?.title || "Thông báo hệ thống"}: ${notification?.message || ""}`;
                });

                let retryAttempt = 0;
                let retryTimer;
                const start = async () => {
                    window.clearTimeout(retryTimer);
                    try {
                        await connection.start();
                        retryAttempt = 0;
                    } catch (error) {
                        const delay = Math.min(30000, 1000 * (2 ** retryAttempt));
                        retryAttempt = Math.min(retryAttempt + 1, 5);
                        retryTimer = window.setTimeout(start, delay);
                    }
                };
                connection.onclose(() => start());
                start();
            })();
        </script>
    }
    <div id="notification-live-region" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
