@using System.Text.Json
@model WmsMes.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">Tổng quan vận hành</p>
        <h2>Bảng điều khiển thời gian thực</h2>
        <p class="text-muted mb-0">Số liệu được đồng bộ tự động khi sản xuất hoặc tồn kho thay đổi.</p>
    </div>
    <div class="connection-pill is-waiting" id="dashboardConnectionState" aria-live="polite">
        <span class="connection-dot"></span>
        <span id="dashboardConnectionLabel">Đang kết nối</span>
    </div>
</section>

<section class="metric-grid" aria-label="Chỉ số vận hành">
    <article class="metric-card">
        <span>Lệnh đang chạy</span>
        <strong id="activeWorkOrders">@Model.ActiveWorkOrders.ToString("N0")</strong>
        <small class="text-muted">Trạng thái In progress</small>
    </article>
    <article class="metric-card">
        <span>Lô chờ QC</span>
        <strong id="pendingQcLots">@Model.PendingQcLots.ToString("N0")</strong>
        <small class="text-muted">Lô có hàng tạm giữ, không gồm khu cách ly</small>
    </article>
    <article class="metric-card">
        <span>Khối lượng tồn kho</span>
        <strong id="inventoryVolume">@Model.InventoryVolume.ToString("N2")</strong>
        <small class="text-muted">Khả dụng + giữ chỗ + tạm giữ</small>
    </article>
</section>

<section class="metric-grid mt-4" aria-label="Chỉ số OEE Sản xuất">
    <article class="metric-card oee-card">
        <span>OEE Tổng thể</span>
        <strong id="overallOee">@Model.OverallOeePercent%</strong>
        <small class="text-muted">Mục tiêu: ≥ 85%</small>
    </article>
    <article class="metric-card">
        <span>Sẵn sàng (Availability)</span>
        <strong id="oeeAvailability">@Model.OeeAvailabilityPercent%</strong>
        <small class="text-muted">Thời gian chạy máy</small>
    </article>
    <article class="metric-card">
        <span>Hiệu suất (Performance)</span>
        <strong id="oeePerformance">@Model.OeePerformancePercent%</strong>
        <small class="text-muted">Tốc độ sản xuất</small>
    </article>
    <article class="metric-card">
        <span>Chất lượng (Quality)</span>
        <strong id="oeeQuality">@Model.OeeQualityPercent%</strong>
        <small class="text-muted">Tỷ lệ thành phẩm đạt</small>
    </article>
    <article class="metric-card">
        <span>Cảnh báo tồn kho tối thiểu</span>
        <strong id="lowStockAlertCount">@Model.LowStockAlertCount</strong>
        <small class="text-muted">Mặt hàng cần được bổ sung</small>
    </article>
</section>

<section class="row mt-4" aria-label="Biểu đồ điều hành sản xuất">
    <div class="col-lg-6 mb-4">
        <div class="card p-3 shadow-sm h-100">
            <h3 class="h6 font-weight-bold mb-3">Sản lượng Sản xuất 7 ngày gần nhất</h3>
            <canvas id="productionChart" style="max-height: 300px;" role="img" aria-label="Sản lượng sản xuất 7 ngày gần nhất">
                Biểu đồ sản lượng sản xuất 7 ngày gần nhất.
            </canvas>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card p-3 shadow-sm h-100">
            <h3 class="h6 font-weight-bold mb-3">Phân bổ Tồn kho theo Zone</h3>
            <canvas id="inventoryZoneChart" style="max-height: 300px;" role="img" aria-label="Phân bổ tồn kho theo Zone">
                Biểu đồ phân bổ tồn kho theo Zone.
            </canvas>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card p-3 shadow-sm h-100">
            <h3 class="h6 font-weight-bold mb-3">Phân bổ Chất lượng</h3>
            <canvas id="qualityChart" style="max-height: 300px;" role="img" aria-label="Phân bổ chất lượng Pass, Hold và Quarantine">
                Biểu đồ phân bổ chất lượng Pass, Hold và Quarantine.
            </canvas>
        </div>
    </div>
</section>

<section class="data-panel mt-4">
    <h3 class="h5">Trạng thái realtime</h3>
    <p class="mb-0 text-muted">Dashboard lắng nghe cập nhật từ hệ thống sản xuất và kho. Khi có tín hiệu, số liệu mới được lấy lại từ máy chủ mà không tải lại trang.</p>
    <p class="mb-0 mt-2 text-muted" id="refreshState" aria-live="polite">Số liệu hiện tại</p>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            const metricsUrl = '@Url.Action("Metrics", "Home")';
            const label = document.getElementById("dashboardConnectionLabel");
            const state = document.getElementById("dashboardConnectionState");
            const number = new Intl.NumberFormat("vi-VN", { maximumFractionDigits: 2 });
            const refreshState = document.getElementById("refreshState");
            const initialMetrics = {
                dailyLabels: @Html.Raw(JsonSerializer.Serialize(Model.DailyLabels)),
                dailyPlannedOutput: @Html.Raw(JsonSerializer.Serialize(Model.DailyPlannedOutput)),
                dailyActualOutput: @Html.Raw(JsonSerializer.Serialize(Model.DailyActualOutput)),
                zoneLabels: @Html.Raw(JsonSerializer.Serialize(Model.ZoneLabels)),
                zoneQuantities: @Html.Raw(JsonSerializer.Serialize(Model.ZoneQuantities)),
                qualityCounts: @Html.Raw(JsonSerializer.Serialize(new[] { Model.PassedQcCount, Model.HoldQcCount, Model.QuarantineQcCount }))
            };
            let productionChart;
            let inventoryZoneChart;
            let qualityChart;
            const initializeCharts = () => {
                if (typeof window.Chart !== "function") return;
                productionChart = new window.Chart(document.getElementById("productionChart"), {
                    type: "bar",
                    data: {
                        labels: initialMetrics.dailyLabels,
                        datasets: [
                            { label: "Kế hoạch", data: initialMetrics.dailyPlannedOutput, backgroundColor: "rgba(13, 110, 253, 0.35)", borderColor: "#0d6efd", borderWidth: 1 },
                            { type: "line", label: "Thực tế", data: initialMetrics.dailyActualOutput, borderColor: "#198754", backgroundColor: "#198754", tension: 0.25, fill: false }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
                inventoryZoneChart = new window.Chart(document.getElementById("inventoryZoneChart"), {
                    type: "doughnut",
                    data: {
                        labels: initialMetrics.zoneLabels,
                        datasets: [{ data: initialMetrics.zoneQuantities, backgroundColor: ["#0d6efd", "#20c997", "#ffc107", "#6f42c1", "#fd7e14"] }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
                qualityChart = new window.Chart(document.getElementById("qualityChart"), {
                    type: "doughnut",
                    data: {
                        labels: ["Pass", "Hold", "Quarantine"],
                        datasets: [{ data: initialMetrics.qualityCounts, backgroundColor: ["#198754", "#ffc107", "#dc3545"] }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            };
            initializeCharts();
            const connectivity = new Map();
            let refreshTimer;
            let refreshGeneration = 0;
            let activeRequest;

            const setState = (text, modifier) => {
                label.textContent = text;
                state.className = `connection-pill ${modifier}`;
            };

            const renderConnectivity = () => {
                const values = [...connectivity.values()];
                const connected = values.filter(value => value === "connected").length;
                if (connected === values.length) setState("Realtime", "is-live");
                else if (connected > 0) setState(`${connected}/${values.length} kênh realtime`, "is-waiting");
                else setState("Mất kết nối", "is-offline");
            };

            const setMetricValue = (id, value, suffix = "") => {
                document.getElementById(id).textContent = `${number.format(value)}${suffix}`;
            };

            const updateCharts = (metrics) => {
                if (!productionChart || !inventoryZoneChart || !qualityChart) return;
                productionChart.data.labels = metrics.dailyLabels;
                productionChart.data.datasets[0].data = metrics.dailyPlannedOutput;
                productionChart.data.datasets[1].data = metrics.dailyActualOutput;
                inventoryZoneChart.data.labels = metrics.zoneLabels;
                inventoryZoneChart.data.datasets[0].data = metrics.zoneQuantities;
                qualityChart.data.datasets[0].data = [metrics.passedQcCount, metrics.holdQcCount, metrics.quarantineQcCount];
                productionChart.update();
                inventoryZoneChart.update();
                qualityChart.update();
            };

            const refreshMetrics = async () => {
                const generation = ++refreshGeneration;
                activeRequest?.abort();
                activeRequest = new AbortController();
                refreshState.textContent = "Đang cập nhật số liệu";
                try {
                    const response = await fetch(metricsUrl, {
                        headers: { "Accept": "application/json" },
                        signal: activeRequest.signal
                    });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const metrics = await response.json();
                    if (generation !== refreshGeneration) return;
                    document.getElementById("activeWorkOrders").textContent = number.format(metrics.activeWorkOrders);
                    document.getElementById("pendingQcLots").textContent = number.format(metrics.pendingQcLots);
                    document.getElementById("inventoryVolume").textContent = number.format(metrics.inventoryVolume);
                    setMetricValue("overallOee", metrics.overallOeePercent, "%");
                    setMetricValue("oeeAvailability", metrics.oeeAvailabilityPercent, "%");
                    setMetricValue("oeePerformance", metrics.oeePerformancePercent, "%");
                    setMetricValue("oeeQuality", metrics.oeeQualityPercent, "%");
                    setMetricValue("lowStockAlertCount", metrics.lowStockAlertCount);
                    updateCharts(metrics);
                    refreshState.textContent = "Số liệu vừa được cập nhật";
                } catch (error) {
                    if (error.name !== "AbortError" && generation === refreshGeneration) {
                        refreshState.textContent = "Không thể cập nhật số liệu";
                    }
                }
            };

            const scheduleRefresh = () => {
                window.clearTimeout(refreshTimer);
                refreshTimer = window.setTimeout(refreshMetrics, 150);
            };

            const createConnection = (name, url, eventName) => {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl(url)
                    .withAutomaticReconnect()
                    .build();
                connection.on(eventName, scheduleRefresh);
                connection.onreconnecting(() => { connectivity.set(name, "connecting"); renderConnectivity(); });
                connection.onreconnected(() => { connectivity.set(name, "connected"); renderConnectivity(); scheduleRefresh(); });
                return { name, connection, retryAttempt: 0, retryTimer: null };
            };

            const connections = [
                createConnection("production", "/productionHub", "ReceiveProgressUpdate"),
                createConnection("inventory", "/inventoryHub", "ReceiveStockUpdate")
            ];

            const startWithRetry = async (hub) => {
                window.clearTimeout(hub.retryTimer);
                connectivity.set(hub.name, "connecting");
                renderConnectivity();
                try {
                    await hub.connection.start();
                    hub.retryAttempt = 0;
                    connectivity.set(hub.name, "connected");
                    renderConnectivity();
                } catch {
                    connectivity.set(hub.name, "offline");
                    renderConnectivity();
                    const delay = Math.min(30000, 1000 * (2 ** hub.retryAttempt));
                    hub.retryAttempt = Math.min(hub.retryAttempt + 1, 5);
                    hub.retryTimer = window.setTimeout(() => startWithRetry(hub), delay);
                }
            };

            connections.forEach(hub => {
                connectivity.set(hub.name, "connecting");
                hub.connection.onclose(() => startWithRetry(hub));
                startWithRetry(hub);
            });
        })();
    </script>
}
