@model IReadOnlyList<WmsMes.Web.Domain.Entities.PickList>
@{
    ViewData["Title"] = "Danh sách lấy hàng";
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">Kho · Fulfillment</p>
        <h2>Danh sách lấy hàng</h2>
        <p class="text-muted mb-0">Ưu tiên vị trí đã tối ưu để hoàn tất đơn bán hàng hiệu quả.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tạo danh sách lấy hàng</a>
</section>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<section class="data-panel">
    <div class="table-responsive">
        <table class="table data-table align-middle mb-0">
            <thead>
                <tr><th>Mã Pick List</th><th>Đơn bán hàng</th><th>Khách hàng</th><th>Ngày tạo</th><th>Trạng thái</th><th aria-label="Thao tác"></th></tr>
            </thead>
            <tbody>
            @foreach (var pickList in Model)
            {
                <tr>
                    <td><code>@pickList.PickListNo</code></td>
                    <td>@pickList.SalesOrder?.OrderNo</td>
                    <td>@pickList.SalesOrder?.Customer?.Code — @pickList.SalesOrder?.Customer?.Name</td>
                    <td>@pickList.CreatedAt.ToVietnameseDateTime()</td>
                    <td><span class="status-pill @(pickList.Status == WmsMes.Web.Domain.Enums.DocumentStatus.Completed ? "is-active" : "is-muted")">@pickList.Status.ToVietnameseString()</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@pickList.Id">Hướng dẫn lấy hàng</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="p-0"><div class="empty-state compact"><h3 class="h5">Chưa có danh sách lấy hàng</h3><p class="mb-3">Chọn đơn bán hàng để hệ thống phân tuyến vị trí lấy hàng.</p><a class="btn btn-primary btn-sm" asp-action="Create">Tạo danh sách đầu tiên</a></div></td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
