@model WmsMes.Web.ViewModels.WorkOrderCreateInputModel
@using WmsMes.Web.Domain.Entities
@{
    ViewData["Title"] = "Tạo lệnh sản xuất";
    var products = ViewData["Products"] as IEnumerable<Product> ?? Enumerable.Empty<Product>();
}

<section class="toolbar-row">
    <div><p class="eyebrow">Lệnh sản xuất</p><h2>Tạo Lệnh sản xuất nháp</h2></div>
</section>

<div class="ops-panel mt-3 col-lg-8">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Code" class="form-label">Mã lệnh</label>
            <input asp-for="Code" class="form-control" maxlength="50" required />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ProductId" class="form-label">Thành phẩm</label>
            <select asp-for="ProductId" class="form-select" required>
                <option value="">-- Chọn thành phẩm --</option>
                @foreach (var product in products)
                {
                    <option value="@product.Id">@product.Code - @product.Name</option>
                }
            </select>
            <span asp-validation-for="ProductId" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Qty" class="form-label">Số lượng yêu cầu</label>
                <input asp-for="Qty" type="number" class="form-control" min="0.01" step="0.01" required />
                <span asp-validation-for="Qty" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="DueDate" class="form-label">Hạn hoàn thành</label>
                <input asp-for="DueDate" type="date" class="form-control" required />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu lệnh nháp</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
