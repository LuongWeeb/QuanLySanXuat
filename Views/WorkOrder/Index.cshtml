@model IEnumerable<WmsMes.Web.Domain.Entities.WorkOrder>
@using WmsMes.Web.Domain.Enums
@using System.Globalization
@{
    ViewData["Title"] = "Lệnh sản xuất";
    var businessDate = (DateTime)ViewData["BusinessDate"]!;
}

<section class="toolbar-row">
    <div>
        <p class="eyebrow">MES</p>
        <h2>Quản lý Lệnh sản xuất</h2>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tạo lệnh nháp</a>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info mt-3" role="status">@statusMessage</div>
}

<section class="data-panel mt-3">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr><th>Mã lệnh</th><th>Thành phẩm</th><th class="text-end">Số lượng</th><th>Tiến độ</th><th>Hạn hoàn thành</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var order in Model)
            {
                var totalProduced = order.DailyProductionLogs.Sum(log => log.QtyProduced);
                var progressPercentage = order.Qty > 0
                    ? totalProduced / order.Qty * 100
                    : 0;
                var progressWidth = Math.Clamp(progressPercentage, 0, 100);
                var targetReached = order.Qty > 0 && totalProduced >= order.Qty;
                var isOverdue = !targetReached && businessDate > order.DueDate.Date;
                var daysRemaining = (order.DueDate.Date - businessDate).Days;
                <tr>
                    <td><code>@order.Code</code></td>
                    <td>@order.Product?.Code - @order.Product?.Name</td>
                    <td class="text-end fw-semibold">@order.Qty.ToVietnameseNumber()</td>
                    <td style="min-width: 14rem;">
                        <div class="d-flex justify-content-between gap-2 small mb-1">
                            <span>@totalProduced.ToVietnameseNumber() / @order.Qty.ToVietnameseNumber()</span>
                            <span>@progressPercentage.ToVietnameseNumber("N1")%</span>
                        </div>
                        <div class="progress" role="progressbar"
                             aria-label="Tiến độ lệnh @order.Code"
                             aria-valuenow="@progressWidth.ToString("0.##", CultureInfo.InvariantCulture)"
                             aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(isOverdue ? "bg-danger" : targetReached ? "bg-success" : "bg-primary")"
                                 style="width: @progressWidth.ToString("0.##", CultureInfo.InvariantCulture)%"></div>
                        </div>
                        @if (isOverdue)
                        {
                            <div class="small text-danger fw-semibold mt-1">Trễ hạn sản xuất!</div>
                        }
                        else if (!targetReached)
                        {
                            <div class="small text-muted mt-1">Còn @daysRemaining.ToVietnameseNumber() ngày</div>
                        }
                    </td>
                    <td>@order.DueDate.ToVietnameseDate()</td>
                    <td><span class="status-pill">@order.Status.ToVietnameseString()</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.Id">Chi tiết</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Chưa có lệnh sản xuất.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
