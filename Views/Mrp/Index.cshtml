@model IEnumerable<WmsMes.Web.DTOs.MrpResultDto>?
@using WmsMes.Web.Domain.Entities
@{
    ViewData["Title"] = "Lập kế hoạch MRP";
    var products = ViewData["Products"] as IEnumerable<Product> ?? Enumerable.Empty<Product>();
    var selectedProductId = ViewData["ProductId"]?.ToString();
}

<section class="ops-panel">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <form asp-action="Calculate" method="post" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="productId">Sản phẩm cần sản xuất</label>
            <select id="productId" name="productId" class="form-select" required aria-describedby="productId-validation">
                <option value="">-- Chọn sản phẩm --</option>
                @foreach (var product in products)
                {
                    <option value="@product.Id" selected="@(selectedProductId == product.Id.ToString())">@product.Code - @product.Name</option>
                }
            </select>
            <span id="productId-validation" class="text-danger">@Html.ValidationMessage("productId")</span>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="qty">Số lượng kế hoạch</label>
            <input id="qty" type="number" name="qty" class="form-control" min="0.01" step="0.01" value="@ViewData["Qty"]" required aria-describedby="qty-validation" />
            <span id="qty-validation" class="text-danger">@Html.ValidationMessage("qty")</span>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Tính MRP</button>
        </div>
    </form>
</section>

@if (Model != null)
{
    <section class="ops-panel mt-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã nguyên liệu</th>
                        <th>Tên nguyên liệu</th>
                        <th class="text-end">Nhu cầu tổng</th>
                        <th class="text-end">Tồn khả dụng</th>
                        <th class="text-end">Thiếu hụt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ComponentCode</td>
                            <td>@item.ComponentName</td>
                            <td class="text-end">@item.GrossDemand.ToString("N2")</td>
                            <td class="text-end">@item.StockAvailable.ToString("N2")</td>
                            <td class="text-end @(item.NetDemand > 0 ? "text-danger fw-bold" : "text-success fw-semibold")">
                                @item.NetDemand.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
