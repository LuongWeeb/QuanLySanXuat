@model WmsMes.Web.ViewModels.QcInspectionInputModel
@using WmsMes.Web.Domain.Enums
@{ ViewData["Title"] = "Thực hiện kiểm định"; }
<section class="toolbar-row"><div><p class="eyebrow">Quality Control</p><h2>Kiểm định lô @Model.LotNo</h2><p class="text-muted mb-0">@Model.ProductDisplay · @Model.ChecklistName</p></div></section>
@if (TempData["StatusMessage"] is string message) { <div class="alert alert-warning mt-3" role="alert">@message</div> }
<div class="ops-panel mt-3"><form asp-action="Inspect" method="post">
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div><input asp-for="LotId" type="hidden"/><input asp-for="ChecklistId" type="hidden"/>
<fieldset><legend class="h5">Thông số đo lường</legend>
@for(var i=0;i<Model.Measurements.Count;i++){<div class="mb-3"><input asp-for="Measurements[i].ChecklistItemId" type="hidden"/><label asp-for="Measurements[i].Value" class="form-label">@Model.Measurements[i].ParameterName @if(Model.Measurements[i].IsRequired){<span aria-hidden="true" class="text-danger">*</span>}</label><div class="input-group"><input asp-for="Measurements[i].Value" class="form-control" required="@Model.Measurements[i].IsRequired" aria-describedby="measurement-help-@i"/><span class="input-group-text">@Model.Measurements[i].Unit</span></div><div id="measurement-help-@i" class="form-text">Giới hạn: @(Model.Measurements[i].MinVal?.ToString() ?? "-") đến @(Model.Measurements[i].MaxVal?.ToString() ?? "-")</div></div>}
</fieldset><div class="mb-3"><label asp-for="Result" class="form-label">Kết quả đề xuất</label><select asp-for="Result" class="form-select"><option value="@QCResult.PASS">PASS - Giải phóng lô</option><option value="@QCResult.REJECT">REJECT - Cách ly lô</option></select></div>
<div class="mb-3"><label asp-for="Note" class="form-label">Ghi chú</label><textarea asp-for="Note" class="form-control" rows="3" maxlength="500"></textarea><span asp-validation-for="Note" class="text-danger"></span></div>
<div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu kết quả</button><a class="btn btn-outline-secondary" asp-action="Index">Hủy</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
